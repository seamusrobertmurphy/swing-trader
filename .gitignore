# secrets
# NOTE: `config.py` was ignored here until 2026-08-26. It holds no secrets,
# only the loader that finds them, and ignoring it meant a fresh clone had no
# config module and every tool died on `import config`. Secrets live in .env
# (below), the environment, or the macOS Keychain, none of which are tracked.
local_config.py
.env
.env.*
# the template below is tracked on purpose and must never hold a real key
!.env.example
*.secret
*.pem
*.key
credentials*.json
local_secrets.py

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
._*

# editor / IDE
.obsidian
.vscode/
.idea/
*.swp
*.swo
.\#*
\#*\#

# python virtualenv and bytecode
__pycache__/
*.pyc

# logs and scratch
*.log
tmp/
scratch/

# market data (large + regenerable: rebuild via flow_data.py / build_dataset*.py)
inputs/binance-data/klines/
inputs/binance-data/klines_1h/
inputs/binance-data/klines_4h/
inputs/binance-data/aggtrades/
flow_1h.csv
inputs/binance-data/flow_1h.csv
inputs/binance-data/flow_4h.csv
inputs/binance-data/daily_flow.csv
inputs/binance-data/dataset_1h_allmarket.csv
inputs/binance-data/dataset_4h_allmarket.csv
inputs/binance-data/_4h_DONE
# market data parquet (large + regenerable; >100MB so GitHub rejects them)
inputs/binance-data/*.parquet
# Alpaca daily bars (regenerable from the API; universe snapshots stay tracked)
inputs/alpaca-data/daily/
inputs/alpaca-data/*.parquet

# python virtualenv (44GB, 28k files; it was tracked until 2026-08-25)
.venv/
venv/

# crypto-era market data, regenerable and the track is closed
inputs/binance-data/funding/
inputs/binance-data/klines_5m/
inputs/binance-data/klines_1d/

# rendered dashboard: regenerated by scripts/render_dashboard.sh on every tick,
# 5MB of embedded assets, and it would churn the diff every 20 minutes
dashboard/dashboard.html
dashboard/dashboard_files/
outputs/dashboard/data.json
# and the page's stamped memory of its own past renders: one small file
# every twenty minutes, capped at 400, local evidence rather than source.
outputs/dashboard/history/
