<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.seamus.daytrader.weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/PortableSSD/Github/day-trader/scripts/weekly_rebalance.sh</string>
  </array>

  <!-- Mon, Tue, Wed at 07:30 local (10:30 New York, an hour after the open).
       Three days because Monday can be a market holiday; the script exits
       quietly when a rebalance already happened inside the weekly window. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/PortableSSD/Github/day-trader</string>
  <key>StandardOutPath</key>
  <string>/Users/seamus/Library/Logs/daytrader/weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/seamus/Library/Logs/daytrader/weekly.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
