[Unit]
Description=Day-trader schedule tick (decides what is due, usually does nothing)
Documentation=file://__REPO__/inputs/schedule_tick.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO__
ExecStart=/bin/bash __REPO__/scripts/tick.sh

# Credentials, in whichever of these exists. The leading "-" means "optional":
# without it systemd refuses to start the unit when the file is absent, which
# is the state on a fresh machine and reads as a broken schedule.
#   ~/.config/daytrader/env   preferred: outside the repo, on a real filesystem
#                             that can actually enforce mode 600
#   __REPO__/.env             also read, by config.py itself, needing nothing here
EnvironmentFile=-%h/.config/daytrader/env

# The tick is a network client and nothing more.
NoNewPrivileges=true
PrivateTmp=true
