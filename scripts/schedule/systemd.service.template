[Unit]
Description=Day-trader schedule tick (decides what is due, usually does nothing)
Documentation=file://__REPO__/inputs/schedule_tick.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO__
ExecStart=/bin/bash __REPO__/scripts/tick.sh

# Credentials. Either put them in __REPO__/.env (mode 600), which config.py
# reads on its own, or uncomment and point this at a file of KEY=value lines
# held outside the repo, which is the tidier choice on a shared machine.
#EnvironmentFile=%h/.config/daytrader/env

# The tick is a network client and nothing more.
NoNewPrivileges=true
PrivateTmp=true
