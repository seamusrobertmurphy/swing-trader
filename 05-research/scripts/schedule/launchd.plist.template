<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <!-- launchd runs /bin/bash and hands it the script, rather than executing
       the script directly: on a removable volume macOS permits executing a
       binary but refuses to read an arbitrary file, so the direct form dies
       with "Operation not permitted" (exit 126) before running a line. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/05-research/scripts/tick.sh</string>
  </array>

  <!-- Every __INTERVAL__ seconds, all day. The tick asks the exchange clock
       what is due, so there is no wall-clock time here to go wrong when the
       machine moves timezone. -->
  <key>StartInterval</key>
  <integer>__INTERVAL__</integer>

  <key>StandardOutPath</key>
  <string>__LOGDIR__/tick.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/tick.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
