# Copy to .env at the repo root, fill in, and chmod 600.
# config.py reads this when the key is not already in the environment.
# .env is gitignored; .env.example is not, and must never hold a real key.

ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# The money switch. "true" arms real orders. Anything else, including unset,
# is false. Leave it false.
LIVE_TRADING=false

# Crypto track, closed 2026-08-17. Only needed to re-run the archive.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
